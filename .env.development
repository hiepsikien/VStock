# Local Expo (`npx expo start` / npm start)
# iPhone (LAN or tunnel): uses EXPO_PUBLIC_DEVICE_API_URL → GCE cloud.
# Simulator: EXPO_PUBLIC_API_URL (localhost) unless you run npm run start:gce.
# Mac + MuseScore: npm run start:local (sets EXPO_PUBLIC_LOCAL_API=1) and
# backend/scripts/run_local.sh. Phone and Mac must share Wi-Fi; do not use --tunnel.
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_DEVICE_API_URL=https://vstock-api.antunai.com
