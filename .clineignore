# .clineignore — keep Cline's context focused on hand-written source.
# Mirrors .gitignore, then adds large generated / vendored / secret paths
# that waste tokens even when they are not tracked by git.

# ---------------------------------------------------------------------------
# Dependencies / vendored code
# ---------------------------------------------------------------------------
node_modules/
**/node_modules/
.venv/
**/.venv/
venv/
**/venv/
vendor/

# Lockfiles are huge and machine-generated; read them only when explicitly asked.
package-lock.json
yarn.lock
pnpm-lock.yaml
poetry.lock
Pipfile.lock

# ---------------------------------------------------------------------------
# Expo / Metro / React Native build output
# ---------------------------------------------------------------------------
.expo/
dist/
web-build/
.expo-shared/
.metro-health-check*
expo-env.d.ts
*.tsbuildinfo

# Generated native folders (regenerated by `expo prebuild`)
/ios/Pods/
/ios/build/
/ios/DerivedData/
/ios/*.xcworkspace/xcuserdata/
/android/.gradle/
/android/build/
/android/app/build/
/android/.cxx/
.kotlin/

# ---------------------------------------------------------------------------
# Python caches / build artifacts
# ---------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
*.so

# ---------------------------------------------------------------------------
# Local databases / ingested data (large binaries, may contain private data)
# ---------------------------------------------------------------------------
backend/data/
research/data/
*.db
*.db-journal
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------
# Secrets / local environment
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.gce.example
!.env.development
!.env.production
*.pem
*.jks
*.p8
*.p12
*.key
*.mobileprovision
credentials.json
service-account*.json

# ---------------------------------------------------------------------------
# Logs / OS noise
# ---------------------------------------------------------------------------
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.orig.*

# ---------------------------------------------------------------------------
# Editor / agent internals
# ---------------------------------------------------------------------------
.git/
.claude/
