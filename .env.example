# Copy to the mode you need, or rely on committed:
#   .env.development  → local API
#   .env.production   → GCE API
#
# Expo: `npx expo start` uses development mode.
# Override once: `npm run start:gce`

EXPO_PUBLIC_API_URL=http://localhost:8000

# Physical device when Metro uses --tunnel (localhost unreachable on phone):
# EXPO_PUBLIC_DEVICE_API_URL=http://34.126.117.158:8000

# Production example:
# EXPO_PUBLIC_API_URL=http://34.126.117.158:8000

# Sentry (mobile) — create a React Native project at https://sentry.io
# EXPO_PUBLIC_SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0
# Optional: also send events from Metro/dev client
# EXPO_PUBLIC_SENTRY_DEV=1
# EAS source maps (do NOT commit): set as EAS secret, or in .env.local
# SENTRY_AUTH_TOKEN=
# Also set organization/project in app.config.ts plugin (@sentry/react-native/expo)

# Backend (Companion) — export in the API terminal, not Expo:
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.5-flash
# Or Vertex: GCP_PROJECT=... GCP_LOCATION=asia-southeast1
# SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_DEBUG_ENDPOINT=1  # only while verifying; remove after