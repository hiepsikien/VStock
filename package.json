{
  "name": "vstock",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.3.11",
    "@react-navigation/native-stack": "^7.18.3",
    "@sentry/react-native": "~8.28.0",
    "babel-preset-expo": "~58.0.0",
    "expo": "^58.0.16",
    "expo-asset": "~58.0.17",
    "expo-audio": "~58.0.9",
    "expo-background-task": "~58.0.11",
    "expo-dev-client": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-notifications": "~58.1.5",
    "expo-status-bar": "~58.0.3",
    "expo-task-manager": "~58.0.12",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:local": "EXPO_PUBLIC_LOCAL_API=1 expo start -c",
    "start:gce": "EXPO_PUBLIC_API_URL=https://vstock-api.antunai.com expo start -c",
    "start:dev": "APP_VARIANT=development expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:dev": "APP_VARIANT=development expo run:ios --device",
    "ios:dev:sim": "APP_VARIANT=development expo run:ios",
    "android:dev": "APP_VARIANT=development expo run:android",
    "prebuild:dev": "APP_VARIANT=development expo prebuild --clean",
    "web": "expo start --web",
    "test:alerts": "npx --yes tsx src/utils/priceAlertLogic.test.ts",
    "test:program": "npx --yes tsx src/sonify/program.test.ts",
    "build:ios:dev": "eas build --platform ios --profile development",
    "build:ios:sim": "eas build --platform ios --profile development-simulator",
    "build:ios:testflight": "eas build --platform ios --profile production --auto-submit",
    "submit:ios": "eas submit --platform ios --profile production --latest",
    "build:android:dev": "eas build --platform android --profile development",
    "generate:icon": "python3 scripts/generate_vstock_icon.py"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
