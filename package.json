{
  "name": "vstock",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.3.11",
    "@react-navigation/native-stack": "^7.18.3",
    "@sentry/react-native": "~7.2.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "^54.0.0",
    "expo-asset": "~12.0.13",
    "expo-background-task": "~1.0.10",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-haptics": "~15.0.8",
    "expo-notifications": "~0.32.17",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "start:local": "expo start -c",
    "start:gce": "EXPO_PUBLIC_API_URL=https://vnstock-api.antunai.com expo start -c",
    "start:dev": "APP_VARIANT=development expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:dev": "APP_VARIANT=development expo run:ios --device",
    "ios:dev:sim": "APP_VARIANT=development expo run:ios",
    "android:dev": "APP_VARIANT=development expo run:android",
    "prebuild:dev": "APP_VARIANT=development expo prebuild --clean",
    "web": "expo start --web",
    "test:alerts": "npx --yes tsx src/utils/priceAlertLogic.test.ts",
    "build:ios:dev": "eas build --platform ios --profile development",
    "build:ios:sim": "eas build --platform ios --profile development-simulator",
    "build:ios:testflight": "eas build --platform ios --profile production --auto-submit",
    "submit:ios": "eas submit --platform ios --profile production --latest",
    "build:android:dev": "eas build --platform android --profile development",
    "generate:icon": "python3 scripts/generate_vstock_icon.py"
  },
  "private": true
}
